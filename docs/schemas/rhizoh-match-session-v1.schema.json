{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "castle.rhizoh.match_session.v1",
  "title": "Rhizoh Match Session v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sessionId", "mode", "state", "players", "turn", "createdAtMs"],
  "properties": {
    "schema": { "const": "castle.rhizoh.match_session.v1" },
    "sessionId": { "type": "string", "minLength": 8, "maxLength": 128 },
    "mode": { "type": "string", "enum": ["KINETIC", "ASYNC"] },
    "state": {
      "type": "string",
      "enum": [
        "BEACON_PENDING",
        "MATCHING",
        "MATCH_FOUND",
        "SESSION_ACTIVE",
        "SESSION_PAUSED",
        "SESSION_FINISHED",
        "SESSION_CANCELLED"
      ]
    },
    "players": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["userId", "color"],
        "properties": {
          "userId": { "type": "string" },
          "color": { "type": "string", "enum": ["white", "black"] },
          "rating": { "type": "integer", "minimum": 0, "maximum": 4000 },
          "kind": { "type": "string", "enum": ["human", "ai_stockfish"] }
        }
      }
    },
    "turn": { "type": "string", "enum": ["white", "black"] },
    "fen": { "type": "string" },
    "lastMoveAtMs": { "type": "integer", "minimum": 0 },
    "deadlineAtMs": { "type": "integer", "minimum": 0 },
    "timeControlMs": { "type": "integer", "minimum": 1000 },
    "opponentKind": { "type": "string", "enum": ["human", "ai_stockfish"] },
    "moveCount": { "type": "integer", "minimum": 0 },
    "result": { "type": "string" },
    "createdAtMs": { "type": "integer", "minimum": 0 },
    "finishedAtMs": { "type": "integer", "minimum": 0 },
    "authority": {
      "type": "object",
      "required": ["mode", "commitRequired", "reconciliation", "effectiveAuthority"],
      "properties": {
        "mode": { "type": "string", "enum": ["SERVER_PRIMARY", "SHADOW_ONLY"] },
        "commitRequired": { "type": "boolean" },
        "reconciliation": { "type": "string", "enum": ["diff-merge", "server-wins"] },
        "effectiveAuthority": { "type": "string", "enum": ["SERVER", "SHADOW_CLIENT", "PENDING_SERVER_ACK"] },
        "serverAuthoritative": { "type": "boolean" },
        "shadowRehearsal": { "type": "boolean" }
      }
    },
    "committed": { "type": "object" },
    "shadow": { "type": "object" },
    "pendingMoves": { "type": "array" },
    "serverAuthoritative": { "type": "boolean" },
    "shadowRehearsal": { "type": "boolean" },
    "interpretationOnly": { "type": "boolean" }
  }
}
