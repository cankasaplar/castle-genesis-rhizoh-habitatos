{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "castle.rhizoh.matchmaking_ws_envelope.v1",
  "title": "Rhizoh Matchmaking WebSocket Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "traceId", "atMs", "payload"],
  "properties": {
    "schema": { "const": "castle.rhizoh.matchmaking_ws_envelope.v1" },
    "type": {
      "type": "string",
      "enum": [
        "MATCH_BEACON_EMIT",
        "MATCH_BEACON_CANCEL",
        "MATCH_BEACON_ACK",
        "MATCH_SESSION_CREATED",
        "MATCH_SESSION_JOIN",
        "MATCH_SESSION_PRESENCE",
        "MATCH_AI_FALLBACK",
        "MATCH_STATE",
        "MATCH_MOVE",
        "MATCH_MOVE_ACK",
        "MATCH_FINISHED",
        "MATCH_ERROR"
      ]
    },
    "traceId": { "type": "string", "maxLength": 128 },
    "sessionId": { "type": "string", "maxLength": 128 },
    "atMs": { "type": "integer", "minimum": 0 },
    "payload": { "type": "object" }
  }
}
