# E2-X — Creative surface cohort (copy → .env.production for dedicated deploy)
# SSOT: apps/client/docs/DEPLOY_MATRIX_V1.0.md §7
# Parent: docs/RHIZOH_SURFACE_LAYER_OPERATING_MODEL_V0.md
#
# Use for: invite cohort where Studio + Map + Chat are LIVE (not observer-only MODE 2).
# Core freeze unchanged: VITE_RHIZOH_PHASE1_SIGNAL=0, no substrate WAL ingress.

# --- Same as .env.production.example base (fill secrets) ---
VITE_CASTLE_AUTHORITY_PROFILE=production
VITE_DEBUG=0
VITE_ONTOLOGICAL_BOOT_GATE=0
VITE_RHIZOH_PHASE1_SIGNAL=0
VITE_RHIZOH_LEGAL_PREAMBLE=1
VITE_RHIZOH_INVITE_ONLY_GOOGLE=1
VITE_RHIZOH_COHORT_SERVER_GATE=1

# Gateway (single origin — match Render)
# VITE_GATEWAY_HTTP=https://YOUR-RENDER-HOST.onrender.com/rhizoh/llm
# VITE_GATEWAY_WS=wss://YOUR-RENDER-HOST.onrender.com
# VITE_LIVE_GATEWAY_BASE=https://YOUR-RENDER-HOST.onrender.com
# VITE_GATEWAY_TOKEN=

# --- E2-X creative surface (client) ---
VITE_RHIZOH_SURFACE_CREATIVE=1
VITE_WORLD_LAYER=1
VITE_RHIZOH_ENTITY_PROJECTION_MAP=1
VITE_CESIUM_WORLD_PROJECTION_BIND=1

# Spiral / substrate stay off
VITE_SPIRAL_MMO_PERCEPTION_BRIDGE=0
VITE_SPIRAL_MMO_AGREEMENT_LAYER=0
# VITE_WAL_GEOMETRY_INGRESS=0

# --- Render gateway (set on server, not Vite) ---
# CASTLE_LIFE_CONTINUITY_APPEND=1
# CASTLE_LIFE_ENTITY_RESOLVER=1
# CASTLE_PROJECTION_ACTIVATION=1
# CASTLE_LIFE_CONTINUITY_RECALL=1
